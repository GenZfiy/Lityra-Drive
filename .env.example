# Copy values into the Render backend service's Environment settings.
# Never put production secrets in GitHub or in Netlify.

APP_ENV=production
PORT=10000
DEBUG=false

# Supabase Connect -> Session pooler (port 5432). URL-encode special characters.
DATABASE_URL=postgresql+psycopg://<pooler-user>:<encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=15

# Generate independent random values; do not use these placeholders as secrets.
JWT_ALG=HS256
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
INTERNAL_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Initial administrator is NOT created by init-db. For a one-time trusted
# `manage.py seed` operation only; do not set these for normal web-service runs.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD

# Add your actual Netlify production and custom-domain origins.
CORS_ORIGINS=https://your-site.netlify.app

# Single-container deployment uses the internal HTTP event bus; Redis is optional.
EVENT_BUS_BACKEND=http
WEB_THREADS=1

# Keep code execution off until a verified OS sandbox is installed in the image.
EXEC_ENABLED=false

# Set SKIP_INIT=1 only after all service schemas have been initialized.
SKIP_INIT=1

# Optional AI integrations. Store real values only in Render secrets.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=4096
DRIVE_AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional email. Render Free cannot send outbound SMTP on ports 25/465/587.
EMAIL_PROVIDER=null
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=
# SMTP_FROM=
# SMTP_PASSWORD=

# Render Free has ephemeral local storage. Uploaded files can be lost on restart.
# Paid Render disk example: STORAGE_DIR=/var/data

# Product boundary
APP_PRODUCT=hire
AUTH_ALLOWED_PRODUCT=hire
JWT_ISSUER=lityra-hire-auth
JWT_AUDIENCE=lityra-hire-api
SERVICE_REGISTRY_PATH=backend/services.txt
SKIP_INIT=1
