# ---- Auth Service configuration ----
SERVICE_NAME=lare-auth
APP_ENV=development
DEBUG=true

# Local dev: SQLite (zero setup). Production: Supabase Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=sqlite:///auth.sqlite3
DB_SCHEMA=auth
SQL_ECHO=false

# JWT — dev uses HS256; production: JWT_ALG=RS256 + JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (PEM)
JWT_ALG=HS256
JWT_SECRET=change-me-please-set-JWT_SECRET
JWT_ISSUER=lare-auth
JWT_AUDIENCE=lare-platform
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Passwords / lockout
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS (comma-separated; * for dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Seed admin
SEED_ADMIN_EMAIL=admin@lareitcloudsolutions.com
SEED_ADMIN_PASSWORD=ChangeMe#123

DEFAULT_TENANT_ID=lare

