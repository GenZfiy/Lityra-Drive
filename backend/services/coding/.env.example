SERVICE_NAME=drive-coding
APP_ENV=development
DEBUG=true
PORT=8016
DATABASE_URL=sqlite:///coding.sqlite3
DB_SCHEMA=drive_coding
# Dev executor (subprocess + timeout). PRODUCTION: swap to an OS sandbox executor.
EXEC_ENABLED=true
EXEC_TIMEOUT_SEC=5
JWT_ALG=HS256
JWT_SECRET=change-me-please-set-JWT_SECRET
JWT_ISSUER=lare-auth
JWT_AUDIENCE=lare-platform
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

