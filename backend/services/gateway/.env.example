# ---- API Gateway configuration ----
SERVICE_NAME=lare-gateway
APP_ENV=development
DEBUG=true

# JWT verification must match the Auth Service. Dev = HS256 shared secret;
# production = RS256 with JWT_PUBLIC_KEY fetched from Auth JWKS.
JWT_ALG=HS256
JWT_SECRET=change-me-please-set-JWT_SECRET
JWT_ISSUER=lare-auth
JWT_AUDIENCE=lare-platform

# Upstream service URLs
AUTH_URL=http://127.0.0.1:8001
INSTITUTION_URL=http://127.0.0.1:8002
LEARNER_URL=http://127.0.0.1:8003
CURRICULUM_URL=http://127.0.0.1:8004
CONTENT_URL=http://127.0.0.1:8005
PROGRESS_URL=http://127.0.0.1:8006

# Rate limits
RATE_LIMIT_PER_MIN=240
EXAM_RATE_LIMIT_PER_MIN=1200
PROXY_TIMEOUT=30

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

